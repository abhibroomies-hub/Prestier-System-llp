# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PRESTIER_ADMIN_PIN: Secret password / PIN for unlocking the Admin Dashboard.
PRESTIER_ADMIN_PIN=

# GOOGLE_APPS_SCRIPT_WEBHOOK_URL: Optional Google Apps Script Web App URL for 24x7 Live Google Sheet sync.
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=



