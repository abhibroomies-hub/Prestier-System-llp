# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Secret password for unlocking the hidden WhatsApp & Admin Sidebar.
# Set this in Railway / Vercel / AI Studio Secrets before production deployment.
ADMIN_PASSCODE=

# ADMIN_SESSION_SECRET: Optional HMAC signing secret for admin bearer sessions.
ADMIN_SESSION_SECRET=

# WHATSAPP_AUTH_DIR: Persistent directory for 24x7 WhatsApp multi-device session (mount a Railway Volume here).
WHATSAPP_AUTH_DIR=./data/whatsapp_auth

# DATA_DIR: Persistent directory for server lead store and settings.
DATA_DIR=./data
