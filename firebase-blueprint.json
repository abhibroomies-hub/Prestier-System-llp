{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "A customer inquiry lead captured in real time (either as an automatic partial draft or a confirmed submission) for Prestier System LLP.",
      "type": "object",
      "properties": {
        "leadId": {
          "type": "string",
          "description": "Unique identifier for the lead record.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionToken": {
          "type": "string",
          "description": "Client-generated opaque session token proving ownership of an active draft.",
          "minLength": 12,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Customer full name.",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Customer phone or WhatsApp number.",
          "maxLength": 32
        },
        "companyName": {
          "type": "string",
          "description": "Customer company or brand name.",
          "maxLength": 150
        },
        "outletsCount": {
          "type": "string",
          "description": "Number of retail or commercial outlets.",
          "maxLength": 24
        },
        "productInterest": {
          "type": "string",
          "description": "Selected product category (empty while partial draft is still being filled).",
          "enum": ["", "Display Cabinet", "Electronic Shelf Label", "Degree-In Equipment"],
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "Lead completion state.",
          "enum": ["partial", "confirmed"]
        },
        "whatsappSent": {
          "type": "boolean",
          "description": "Whether automated WhatsApp confirmation was dispatched."
        },
        "sheetSynced": {
          "type": "boolean",
          "description": "Whether this row has been synced to Google Sheets."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the lead was first created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the lead was last updated."
        }
      },
      "required": [
        "leadId",
        "sessionToken",
        "name",
        "phone",
        "companyName",
        "outletsCount",
        "productInterest",
        "status",
        "whatsappSent",
        "sheetSynced",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Trusted administrator marker document.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "createdAt"]
    },
    "IntegrationConfig": {
      "title": "IntegrationConfig",
      "description": "Google Sheets spreadsheet sync configuration stored by the admin.",
      "type": "object",
      "properties": {
        "spreadsheetId": {
          "type": "string",
          "maxLength": 128
        },
        "spreadsheetTitle": {
          "type": "string",
          "maxLength": 200
        },
        "sheetName": {
          "type": "string",
          "maxLength": 100
        },
        "autoSyncEnabled": {
          "type": "boolean"
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "spreadsheetId",
        "spreadsheetTitle",
        "sheetName",
        "autoSyncEnabled",
        "updatedBy",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Real-time customer leads (partial auto-saved drafts and confirmed submissions). Read/List restricted to verified Admins to protect customer PII."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin role lookup collection."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/IntegrationConfig" },
      "description": "Admin-managed Google Sheets integration configuration."
    }
  }
}
